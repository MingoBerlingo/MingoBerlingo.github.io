d":120},"6ae9da5d2756dce0f10604ee",{"id":122},"6aad520fe6ebe5c3c1970865",[],{"heading":125,"keywordsHeading":126,"signature":127},"Make it clear.\nMake it feel right.","A few things I work with","In ♥ with pixels"],"uses":{}},{"type":"data","data":[{"suggestedProjects":1,"project":27},[2,16],{"id":3,"slug":4,"title":5,"shortTitle":5,"tagline":6,"year":7,"isFeatured":8,"featuredImage":9,"videoCover":15},"6ac8b04e1617bfc2eb4349f3","berachain","Berachain","Designing the face of a blockchain","2026-04-01T12:00:00.000Z",true,{"previewDataURL":10,"url":11,"alt":12,"width":13,"height":14},"data:image/jpeg;base64,","/media/berachain-cover.png","Berachain landing page hero section",1920,1080,null,{"id":17,"slug":18,"title":19,"shortTitle":20,"tagline":21,"year":22,"isFeatured":8,"featuredImage":23,"videoCover":15},"6ae9da5d2756dce0f10604ee","aura","Aura.money","Aura","Building a social trading app","2025-01-01T12:00:00.000Z",{"previewDataURL":24,"url":25,"alt":26,"width":13,"height":14},"data:image/jpeg;base64,","/media/aura-cover.png","Aura trading app on a phone against a blue sky and clouds",{"id":28,"slug":29,"title":30,"shortTitle":31,"tagline":32,"year":33,"isFeatured":8,"isMinor":34,"client":35,"role":36,"output":37,"featuredImage":38,"videoCover":43,"links":48,"collaborators":52,"contentHtml":53,"createdAt":54,"updatedAt":55},"69b82286a7b096ca69eaf705","vcat","Visual Content Assessment Tool","VCAT","Helping Wikipedians filling gaps in visual content","2023-10-01T12:00:00.000Z",false,"Master Thesis","Research, design and development","Web App",{"previewDataURL":39,"url":40,"alt":41,"width":13,"height":42},"data:image/jpeg;base64,","/media/VCAT-screens.png","Visual Content Assessment Tool dashboard screens",1200,{"previewDataURL":44,"url":45,"alt":46,"width":15,"height":15,"mimeType":47},"data:image/jpeg;base64,","/media/vcat_presentation_v1.webm","VCAT dashboard presentation","video/webm",[49],{"label":50,"url":51},"Dashboard","https://mingoberlingo.github.io/VCAT-dashboard/",[],"\u003Ch1>Overview\u003C/h1>\u003Ch2>Visual Content Assessment Tool\u003C/h2>\u003Cp>VCAT, short for Visual Content Assessment Tool, is an interactive dashboard specifically crafted to monitor images within Wikipedia's thematic niches. It helps contributors in addressing gaps in visual content through data visualization.\u003C/p>\u003Cp>\u003Cbr />\u003C/p>\n                \u003Cdiv data-media data-media-state=\"loading\" class=\"media-frame\">\u003Cimg data-preview src=\"data:image/jpeg;base64,\" alt=\"\" aria-hidden=\"true\" class=\"media-preview\" />\u003Cvideo data-deferred preload=\"none\" poster=\"data:image/jpeg;base64,\" data-src=\"/media/vcat_dashboar_overview.webm\" data-autoplay muted loop playsinline>\u003C/video>\u003Cnoscript>\u003Cvideo controls preload=\"none\" poster=\"data:image/jpeg;base64,\" src=\"/media/vcat_dashboar_overview.webm\" muted loop playsinline>\u003C/video>\u003C/noscript>\u003C/div>\n              \u003Cp>\u003Cbr />\u003C/p>\u003Cp>Complementing the dashboard, an extraction tool has been designed and developed to empower users to extract up-to-date data about articles of their interest.\u003C/p>\u003Cp>This initiative stems from insights collected during the research of my master thesis on user collaboration practices related to images on Wikipedia.\u003C/p>\u003Cdiv class=\"media-layout media-layout--grid\">\u003Cdiv class=\"media-layout-row media-layout-row--columns-1\">\u003Cdiv data-media data-media-state=\"loading\" class=\"media-frame\">\u003Cimg data-preview src=\"data:image/jpeg;base64,\" alt=\"\" aria-hidden=\"true\" class=\"media-preview\" />\u003Cvideo data-deferred preload=\"none\" poster=\"data:image/jpeg;base64,\" data-src=\"/media/vcat_data_extraction.webm\" data-autoplay muted loop playsinline>\u003C/video>\u003Cnoscript>\u003Cvideo controls preload=\"none\" poster=\"data:image/jpeg;base64,\" src=\"/media/vcat_data_extraction.webm\" muted loop playsinline>\u003C/video>\u003C/noscript>\u003C/div>\u003C/d