d":120},"6ae9da5d2756dce0f10604ee",{"id":122},"6aad520fe6ebe5c3c1970865",[],{"heading":125,"keywordsHeading":126,"signature":127},"Make it clear.\nMake it feel right.","A few things I work with","In ♥ with pixels"],"uses":{}},{"type":"data","data":[{"suggestedProjects":1,"project":27},[2,16],{"id":3,"slug":4,"title":5,"shortTitle":5,"tagline":6,"year":7,"isFeatured":8,"featuredImage":9,"videoCover":15},"6ac8b04e1617bfc2eb4349f3","berachain","Berachain","Designing the face of a blockchain","2026-04-01T12:00:00.000Z",true,{"previewDataURL":10,"url":11,"alt":12,"width":13,"height":14},"data:image/jpeg;base64,","/media/berachain-cover.png","Berachain landing page hero section",1920,1080,null,{"id":17,"slug":18,"title":19,"shortTitle":20,"tagline":21,"year":22,"isFeatured":8,"featuredImage":23,"videoCover":15},"6ae9da5d2756dce0f10604ee","aura","Aura.money","Aura","Building a social trading app","2025-01-01T12:00:00.000Z",{"previewDataURL":24,"url":25,"alt":26,"width":13,"height":14},"data:image/jpeg;base64,","/media/aura-cover.png","Aura trading app on a phone against a blue sky and clouds",{"id":28,"slug":29,"title":30,"shortTitle":30,"tagline":31,"year":32,"isFeatured":33,"isMinor":33,"client":34,"role":35,"output":36,"featuredImage":37,"videoCover":41,"links":43,"collaborators":47,"contentHtml":60,"createdAt":61,"updatedAt":62},"6aacfdd8cb6f21f01abb4a45","my-covid-souvenir","My Covid Souvenir"," Making sense of the objects sold during the Covid pandemic","2022-01-01T12:00:00.000Z",false,"University Project","Research and visualization","Website",{"previewDataURL":38,"url":39,"alt":40,"width":15,"height":15},"data:image/jpeg;base64,","/media/my-covid-souvenir-presentation.webm","My covid souvenir project presentation",{"previewDataURL":38,"url":39,"alt":40,"width":15,"height":15,"mimeType":42},"video/webm",[44],{"label":45,"url":46},"Research report","https://mingoberlingo.github.io/personal-website/images/projects/Covid-Objects-Report/Materiality%20of%20COVID-19%20report.pdf",[48,50,52,54,56,58],{"name":49},"Daniele Dell'Orto",{"name":51},"Martina Francella",{"name":53},"Martina Melillo",{"name":55},"Matteo Pini",{"name":57},"Octavian Husoschi",{"name":59},"Shan Huang","\u003Ch1>Overview\u003C/h1>\u003Ch2>The Covid Objects\u003C/h2>\u003Cp>“Covid object” is a label fit to any product in close relation with the pandemic. This research's goal is to find out what these objects are, what was the price fluctuation and how the open-source community reacted when the production chain failed to deliver the needed goods.\u003C/p>\n        \u003Cspan data-media data-media-state=\"loading\" class=\"media-frame\">\u003Cimg loading=\"lazy\" alt=\"my-covid-souvenir-report-covers.jpg\" height=\"1280\" src=\"/media/my-covid-souvenir-report-covers.jpg\" width=\"1920\" />\u003C/span>\n      \u003Ch1>Goal\u003C/h1>\u003Cp>The goal of the research is to objectively depict the global approach to covid objects to better understand the materiality of covid in the post-pandemic future.\u003C/p>\u003Cp>The analysis of COVID-related items across 17 Amazon marketplaces worldwide has revealed that many of these items serve as souvenirs, encapsulating ideas, trends, and opinions about the pandemic. An online archive has been created to facilitate the exploration of these objects.\u003C/p>\n                \u003Cdiv data-media data-media-state=\"loading\" class=\"media-frame\">\u003Cimg data-preview src=\"data:image/jpeg;base64,\" alt=\"\" aria-hidden=\"true\" class=\"media-preview\" />\u003Cvideo data-deferred preload=\"none\" poster=\"data:image/jpeg;base64,\" data-src=\"/media/my-covid-souvenir-website-scroll.webm\" data-autoplay muted loop playsinline>\u003C/video>\u003Cnoscript>\u003Cvideo controls preload=\"none\" poster=\"data:image/jpeg;base64,\" src=\"/media/my-covid-souvenir-website-scroll.webm\" muted loop playsinline>\u003C/video>\u003C/noscript>\u003C/div>\n              \n        \u003Cspan data-media data-media-state=\"loading\" class=\"media-frame\">\u003Cimg loading=\"lazy\" alt=\"my-covid-souvenir-inner-pages-1.jpg\" height=\"1280\" src=\"/media/my-covid-souvenir-inner-pages-1.jpg\" width=\"1920\" />\u003C/span>\n      \n        \u003Cspan data-media data-media-state=\"loading\" class=\"media-frame\">\u003Cimg loading=\"lazy\" alt=\"my-covid-souvenir-inner-pages-2.jpg\" height=\"1280\" src=\"/media/my-covid-souvenir-inner-pages-2.jpg\" width=\"1920\" />\u003C/span>\n      \n        \u003Cspan data-media data-media-state=\"loading\" class=\"media-frame\">\u003Cimg loading=\"lazy\" alt=\"my-covid-souvenir-inner-pages-3.jpg\" height=\"1280\" src=\"/media/my-covid-souvenir-inner-pages-3.jpg\" width=\"1920\" />\u003C/span>\n      \u003Cp>\u003Cbr />\u003C/p>","2026-09-18T09:01:12.939Z","2026-09-18T09:09:03.777Z"],"uses":{"params":["slug"],"parent":1}}]}
